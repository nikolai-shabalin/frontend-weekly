---
const searchId = 'site-search';
const resultsId = 'site-search-results';
---

<div class="search" data-search>
  <button
    type="button"
    class="search__toggle"
    data-search-toggle
    aria-label="Открыть поиск"
    aria-expanded="false"
    aria-controls={searchId}
  >
    <svg class="search__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
      <path d="M16.5 16.5 21 21" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
    </svg>
  </button>

  <div class="search__box" data-search-box>
    <label class="sr-only" for={searchId}>Поиск по статьям</label>
    <input
      id={searchId}
      class="search__input"
      data-search-input
      type="search"
      placeholder="Поиск по статьям"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={resultsId}
      aria-keyshortcuts="Control+K Meta+K"
    />
    <kbd class="search__hotkey" data-search-hotkey>Ctrl K</kbd>
    <div
      class="search__dropdown"
      data-search-dropdown
      hidden
    >
      <div class="search__status" data-search-status hidden></div>
      <ul
        class="search__results"
        id={resultsId}
        data-search-results
        role="listbox"
      ></ul>
    </div>
  </div>
</div>

<script>
  import MiniSearch from 'minisearch';
  import { miniSearchOptions } from '../lib/search/engine';

  const MIN_QUERY_LENGTH = 2;
  const MAX_RESULTS = 8;
  const INDEX_URL = `${import.meta.env.BASE_URL}search-index.json`.replace(/\/{2,}/g, '/');

  let miniSearch: MiniSearch | null = null;
  let indexPromise: Promise<void> | null = null;
  let documentAbort: AbortController | null = null;

  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch(INDEX_URL)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Failed to load search index: ${response.status}`);
          }
          return response.json();
        })
        .then((index) => {
          miniSearch = MiniSearch.loadJS(index, miniSearchOptions);
        })
        .catch((error) => {
          indexPromise = null;
          throw error;
        });
    }

    return indexPromise;
  }

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function highlight(text: string, query: string) {
    const escaped = escapeHtml(text);
    const terms = query
      .trim()
      .split(/\s+/)
      .filter((term) => term.length > 0)
      .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));

    if (terms.length === 0) {
      return escaped;
    }

    return escaped.replace(new RegExp(`(${terms.join('|')})`, 'gi'), '<mark>$1</mark>');
  }

  function digestLabel(title: string) {
    const match = title.match(/#\d+/);
    return match ? `Дайджест ${match[0]}` : title;
  }

  const SEARCH_FRAGMENT_KEY = 'search-text-fragment';

  function encodeTextFragment(text: string) {
    return encodeURIComponent(text.trim())
      .replaceAll('-', '%2D')
      .replaceAll("'", '%27');
  }

  function articleHref(href: string, title: string) {
    const url = new URL(href, window.location.origin);
    url.hash = `:~:text=${encodeTextFragment(title)}`;
    return `${url.pathname}${url.hash}`;
  }

  function findTextRange(root: Element, needle: string) {
    const query = needle.replace(/\s+/g, ' ').trim();
    if (!query) {
      return null;
    }

    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const parent = node.parentElement;
        if (!parent || parent.closest('[data-search], script, style, noscript')) {
          return NodeFilter.FILTER_REJECT;
        }
        return NodeFilter.FILTER_ACCEPT;
      },
    });

    const parts: Array<{ node: Text; start: number }> = [];
    let haystack = '';
    let current = walker.nextNode();

    while (current instanceof Text) {
      parts.push({ node: current, start: haystack.length });
      haystack += current.nodeValue ?? '';
      current = walker.nextNode();
    }

    const index = haystack.toLowerCase().indexOf(query.toLowerCase());
    if (index === -1) {
      return null;
    }

    const endIndex = index + query.length;
    const range = document.createRange();

    for (const part of parts) {
      const value = part.node.nodeValue ?? '';
      const partEnd = part.start + value.length;

      if (index >= part.start && index < partEnd) {
        range.setStart(part.node, index - part.start);
      }

      if (endIndex > part.start && endIndex <= partEnd) {
        range.setEnd(part.node, endIndex - part.start);
        break;
      }
    }

    return range;
  }

  function applySearchHighlight() {
    if ('highlights' in CSS) {
      CSS.highlights.delete('search-result');
    }

    const text = sessionStorage.getItem(SEARCH_FRAGMENT_KEY);
    sessionStorage.removeItem(SEARCH_FRAGMENT_KEY);

    if (!text || !('highlights' in CSS)) {
      return;
    }

    const root = document.querySelector('.content') ?? document.querySelector('main');
    if (!(root instanceof HTMLElement)) {
      return;
    }

    const range = findTextRange(root, text);
    if (!range) {
      return;
    }

    CSS.highlights.set('search-result', new Highlight(range));

    const target = range.startContainer instanceof Element
      ? range.startContainer
      : range.startContainer.parentElement;
    target?.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'smooth' });
  }

  function isMacPlatform() {
    return /Mac|iPhone|iPad/.test(navigator.platform);
  }

  function setupSearch() {
    const root = document.querySelector('[data-search]');
    const input = document.querySelector('[data-search-input]');
    const toggle = document.querySelector('[data-search-toggle]');
    const dropdown = document.querySelector('[data-search-dropdown]');
    const results = document.querySelector('[data-search-results]');
    const status = document.querySelector('[data-search-status]');
    const hotkey = document.querySelector('[data-search-hotkey]');

    if (
      !(root instanceof HTMLElement) ||
      !(input instanceof HTMLInputElement) ||
      !(toggle instanceof HTMLButtonElement) ||
      !(dropdown instanceof HTMLElement) ||
      !(results instanceof HTMLElement) ||
      !(status instanceof HTMLElement)
    ) {
      return;
    }

    documentAbort?.abort();
    documentAbort = new AbortController();
    const { signal } = documentAbort;

    let activeIndex = -1;
    let currentHrefs: string[] = [];

    if (hotkey instanceof HTMLElement) {
      hotkey.textContent = isMacPlatform() ? '⌘K' : 'Ctrl K';
    }

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Закрыть поиск' : 'Открыть поиск');
    };

    const setDropdownOpen = (open: boolean) => {
      dropdown.hidden = !open;
      input.setAttribute('aria-expanded', String(open));
    };

    const setActive = (index: number) => {
      const options = results.querySelectorAll('[role="option"]');
      activeIndex = index;
      options.forEach((option, optionIndex) => {
        const isActive = optionIndex === index;
        option.classList.toggle('is-active', isActive);
        option.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          input.setAttribute('aria-activedescendant', option.id);
          option.scrollIntoView({ block: 'nearest' });
        }
      });

      if (index < 0) {
        input.removeAttribute('aria-activedescendant');
      }
    };

    const showStatus = (message: string) => {
      status.hidden = false;
      status.textContent = message;
      results.replaceChildren();
      currentHrefs = [];
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');
      setDropdownOpen(true);
    };

    const renderResults = (
      items: Array<{ title: string; category: string; digestTitle: string; href: string }>,
      query: string,
    ) => {
      status.hidden = true;
      currentHrefs = items.map((item) => item.href);
      results.innerHTML = items
        .map((item, index) => {
          const category = item.category ? `${escapeHtml(item.category)} · ` : '';
          return `
            <li class="search__result" role="option" id="site-search-option-${index}" aria-selected="false">
              <a
                class="search__link"
                href="${escapeHtml(articleHref(item.href, item.title))}"
                data-text-fragment="${escapeHtml(item.title)}"
              >
                <span class="search__title">${highlight(item.title, query)}</span>
                <span class="search__meta">${category}${escapeHtml(digestLabel(item.digestTitle))}</span>
              </a>
            </li>
          `;
        })
        .join('');
      setDropdownOpen(true);
      setActive(items.length > 0 ? 0 : -1);
    };

    const runSearch = async () => {
      const query = input.value.trim();

      if (query.length < MIN_QUERY_LENGTH) {
        setDropdownOpen(false);
        results.replaceChildren();
        status.hidden = true;
        currentHrefs = [];
        return;
      }

      try {
        await loadIndex();
      } catch {
        showStatus('Не удалось загрузить поиск');
        return;
      }

      if (!miniSearch) {
        showStatus('Не удалось загрузить поиск');
        return;
      }

      const hits = miniSearch.search(query);
      const items = hits.slice(0, MAX_RESULTS).map((hit) => ({
        title: String(hit.title ?? ''),
        category: String(hit.category ?? ''),
        digestTitle: String(hit.digestTitle ?? ''),
        href: String(hit.href ?? ''),
      }));

      if (items.length === 0) {
        showStatus('Ничего не найдено');
        return;
      }

      renderResults(items, query);
    };

    const openAndFocus = () => {
      setOpen(true);
      input.focus();
      void loadIndex();
      void runSearch();
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      if (root.classList.contains('is-open')) {
        setOpen(false);
        setDropdownOpen(false);
        input.blur();
        return;
      }
      openAndFocus();
    }, { signal });

    input.addEventListener('focus', () => {
      setOpen(true);
      void loadIndex();
      void runSearch();
    }, { signal });

    input.addEventListener('input', () => {
      void runSearch();
    }, { signal });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setDropdownOpen(false);
        setOpen(false);
        input.blur();
        return;
      }

      if (dropdown.hidden || currentHrefs.length === 0) {
        return;
      }

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive((activeIndex + 1) % currentHrefs.length);
        return;
      }

      if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive((activeIndex - 1 + currentHrefs.length) % currentHrefs.length);
        return;
      }

      if (event.key === 'Enter' && activeIndex >= 0) {
        const optionLink = results.querySelector(`#site-search-option-${activeIndex} a`);
        if (optionLink instanceof HTMLAnchorElement) {
          event.preventDefault();
          optionLink.click();
        }
      }
    }, { signal });

    results.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('a.search__link')
        : null;
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const text = link.dataset.textFragment;
      if (text) {
        sessionStorage.setItem(SEARCH_FRAGMENT_KEY, text);
      }
    }, { signal });

    results.addEventListener('mousemove', (event) => {
      const option = event.target instanceof Element
        ? event.target.closest('[role="option"]')
        : null;
      if (!option) {
        return;
      }
      const options = [...results.querySelectorAll('[role="option"]')];
      const index = options.indexOf(option);
      if (index >= 0 && index !== activeIndex) {
        setActive(index);
      }
    }, { signal });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node) || root.contains(event.target)) {
        return;
      }
      setDropdownOpen(false);
      setOpen(false);
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openAndFocus();
      }
    }, { signal });
  }

  document.addEventListener('astro:page-load', () => {
    setupSearch();
    applySearchHighlight();
  });
  setupSearch();
  applySearchHighlight();
</script>

<style>
  .search {
    position: relative;
    flex: 1 1 12rem;
    min-width: 0;
    max-width: 32rem;
  }

  .search__toggle {
    display: none;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 2px solid rgba(44, 75, 24, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    color: rgb(var(--ink));
    cursor: pointer;
  }

  .search__box {
    position: relative;
    width: 100%;
  }

  .search__input {
    width: 100%;
    height: 2.4rem;
    padding: 0 3.1rem 0 0.9rem;
    border: 2px solid rgba(44, 75, 24, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    color: rgb(var(--ink));
    font: inherit;
    font-size: var(--text-sm);
    appearance: none;
  }

  .search__input::placeholder {
    color: rgb(var(--muted));
  }

  .search__input::-webkit-search-decoration,
  .search__input::-webkit-search-cancel-button {
    appearance: none;
  }

  .search__hotkey {
    position: absolute;
    top: 50%;
    right: 0.55rem;
    transform: translateY(-50%);
    padding: 0.12rem 0.38rem;
    border: 1px solid rgba(var(--line), 0.7);
    border-radius: 6px;
    background: rgba(252, 248, 237, 0.8);
    color: rgb(var(--muted));
    font-family: var(--font-accent);
    font-size: 0.7rem;
    line-height: 1;
    pointer-events: none;
  }

  .search__dropdown {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 50%;
    z-index: 200;
    width: min(42rem, calc(100vw - 2rem));
    min-width: 100%;
    transform: translateX(-50%);
    overflow: hidden;
    border: 2px solid rgba(var(--line), 0.65);
    border-radius: var(--radius-md);
    background: var(--paper-color);
    box-shadow: var(--shadow-soft);
  }

  .search__status {
    padding: 0.9rem 1rem;
    color: rgb(var(--muted));
    font-size: var(--text-sm);
  }

  .search__results {
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    max-height: min(24rem, 70vh);
    overflow: auto;
  }

  .search__dropdown :global(.search__result) {
    border-radius: var(--radius-sm);
  }

  .search__dropdown :global(.search__link) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.65rem 0.75rem;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .search__dropdown :global(.search__title) {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.35;
  }

  .search__dropdown :global(.search__meta) {
    color: rgb(var(--muted));
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search__dropdown :global(.search__result.is-active),
  .search__dropdown :global(.search__result:hover) {
    background: rgba(var(--accent-yellow-bg-rgb), 0.28);
  }

  .search__dropdown :global(mark) {
    color: inherit;
    background: rgba(var(--accent-yellow-bg-rgb), 0.7);
    border-radius: 3px;
    padding: 0 0.1em;
  }

  @media (prefers-color-scheme: dark) {
    .search__toggle,
    .search__input {
      border-color: rgba(var(--line), 0.55);
      background: rgba(0, 0, 0, 0.28);
      color: rgb(var(--ink));
    }

    .search__hotkey {
      background: rgba(26, 35, 32, 0.85);
      border-color: rgba(var(--line), 0.55);
    }

    .search__dropdown :global(.search__result.is-active),
    .search__dropdown :global(.search__result:hover) {
      background: rgba(var(--accent-yellow-bg-rgb), 0.16);
    }
  }

  @media (max-width: 720px) {
    .search {
      position: static;
      flex: 0 0 auto;
      max-width: none;
    }

    .search__toggle {
      display: grid;
    }

    .search__box {
      display: none;
      position: absolute;
      top: calc(100% + 0.55rem);
      left: var(--space-sm);
      right: var(--space-sm);
      z-index: 200;
      width: auto;
    }

    .search.is-open .search__box {
      display: block;
    }

    .search__hotkey {
      display: none;
    }

    .search__input {
      padding-right: 0.9rem;
      background: var(--paper-color);
      box-shadow: var(--shadow-soft);
    }

    .search__dropdown {
      left: 0;
      width: auto;
      min-width: 0;
      transform: none;
    }
  }
</style>
